# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PREDICTOR_ACCESS_CODE: Operator code required to unlock the hidden crash predictor.
PREDICTOR_ACCESS_CODE="LM-PREDICT-2026"

# ---------------- REAL SMS DELIVERY PROVIDERS ----------------
# Configure ONE of the following in AI Studio Secrets to deliver OTP codes to real phones (Messages app):

# Option 1: Africa's Talking (Recommended for Kenya +254, Ghana +233, Côte d'Ivoire +225)
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""
AFRICASTALKING_SENDER_ID=""

# Option 2: Twilio Programmable SMS (recommended)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_VERIFY_SERVICE_SID=""

# Option 3: Termii (Africa-wide SMS routing)
TERMII_API_KEY=""
TERMII_SENDER_ID="Luckymate"
TERMII_CHANNEL="generic"

# Option 4: Vonage / Textbelt / Custom Webhook
VONAGE_API_KEY=""
VONAGE_API_SECRET=""
TEXTBELT_API_KEY=""
SMS_WEBHOOK_URL=""

# ---------------- PAYSTACK REAL PAYMENTS (STK PUSH) ----------------
# Configure your Paystack Secret Key in AI Studio Secrets to trigger real Mobile Money STK Push
# prompts (Kenya M-PESA, Ghana MTN/Telecel/AirtelTigo, Côte d'Ivoire Orange/MTN/Moov/Wave):
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# ---------------- EMAIL OTP VERIFICATION PROVIDERS ----------------
# Configure ONE of the following in AI Studio Secrets to send 6-digit account-activation OTP emails:
# Option 1: Gmail App Password (easiest for Gmail accounts)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Option 2: Resend / SendGrid / Brevo transactional email API
RESEND_API_KEY=""
SENDGRID_API_KEY=""
BREVO_API_KEY=""
EMAIL_FROM=""

# Option 3: Custom SMTP Server
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="true"
